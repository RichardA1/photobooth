[Unit]
Description=Photobooth gallery web server
After=network.target

[Service]
Type=simple
User=pi
Environment=PHOTOBOOTH_DIR=/home/pi/photobooth/photos
WorkingDirectory=/home/pi/photobooth
# Port 80 needs CAP_NET_BIND_SERVICE (granted via AmbientCapabilities)
AmbientCapabilities=CAP_NET_BIND_SERVICE
ExecStart=/usr/bin/python3 /home/pi/photobooth/gallery_server.py
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
