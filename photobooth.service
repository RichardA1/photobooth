[Unit]
Description=Photobooth (capture + web UI)
After=network.target

[Service]
Type=simple
# rpi_ws281x needs /dev/mem for PWM DMA + port 80 needs privilege
User=root
Environment=PHOTOBOOTH_DIR=/home/pi/photobooth/photos
WorkingDirectory=/home/pi/photobooth
ExecStart=/usr/bin/python3 /home/pi/photobooth/photobooth.py
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
